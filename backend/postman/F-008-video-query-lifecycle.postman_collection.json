    {
      "name": "13. US2 - Xem chi tiết Video 1 qua JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code là 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Thông tin chi tiết video khớp videoId1\", function () {",
              "    pm.expect(jsonData.videoId).to.eql(pm.collectionVariables.get(\"videoId1\"));",
              "    pm.expect(jsonData.status).to.eql(\"UPLOADING\");",
              "    pm.expect(jsonData.assets == null || jsonData.assets === undefined).to.be.true;",
              "});"
            ]
          }
        }
