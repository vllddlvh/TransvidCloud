        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dự án A - Khoá học Java\",\n  \"description\": \"Dự án mẫu của User A\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/projects",
          "host": ["{{baseUrl}}"],
          "path": ["projects"]
        }
