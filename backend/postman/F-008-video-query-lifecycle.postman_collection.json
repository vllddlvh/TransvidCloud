    {
      "name": "08. US1 - Danh sách Video trang 1 (limit=2, cursor=null)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code là 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Trang 1 có 2 items và hasMore = true\", function () {",
              "    pm.expect(jsonData.items.length).to.eql(2);",
              "    pm.expect(jsonData.hasMore).to.eql(true);",
              "    pm.expect(jsonData.nextCursor).to.be.a('string');",
              "});",
              "pm.collectionVariables.set(\"cursor1\", jsonData.nextCursor);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tokenA}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectAId}}/videos?limit=2",
          "host": ["{{baseUrl}}"],
          "path": ["projects", "{{projectAId}}", "videos"],
          "query": [
            { "key": "limit", "value": "2" }
          ]
        }
      }
    },
    {
      "name": "09. US1 - Danh sách Video trang 2 (limit=2, cursor=cursor1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code là 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Trang 2 có 1 item và hasMore = false\", function () {",
              "    pm.expect(jsonData.items.length).to.eql(1);",
              "    pm.expect(jsonData.hasMore).to.eql(false);",
              "    pm.expect(jsonData.nextCursor == null || jsonData.nextCursor === undefined).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tokenA}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectAId}}/videos?limit=2&cursor={{cursor1}}",
          "host": ["{{baseUrl}}"],
          "path": ["projects", "{{projectAId}}", "videos"],
          "query": [
            { "key": "limit", "value": "2" },
            { "key": "cursor", "value": "{{cursor1}}" }
          ]
        }
      }
    },
    {
      "name": "10. US1 - Danh sách Video qua API Key",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code là 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Trả về đầy đủ danh sách qua API Key\", function () {",
              "    pm.expect(jsonData.items.length).to.be.at.least(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{apiKeyA}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectAId}}/videos",
          "host": ["{{baseUrl}}"],
          "path": ["projects", "{{projectAId}}", "videos"]
        }
      }
    },
