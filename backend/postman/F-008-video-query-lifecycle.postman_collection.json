{
  "info": {
    "_postman_id": "tvc-f008-video-query-lifecycle",
    "name": "F-008: Truy Vấn Danh Sách (Cursor Pagination), Chi Tiết, Assets & Xóa Video",
    "description": "Bộ Postman Collection E2E cho Feature F-008: Truy vấn Danh sách Video theo Dự án kèm Phân trang Con trỏ (GSI project-index), Tra cứu Chi tiết & Assets HLS/Thumbnail, Xóa Video (Fast Delete & Conflict Guard) và Phân quyền Đa người thuê Dual Security (Bearer JWT & X-API-Key).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
