              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Mã lỗi là INVALID_CURSOR\", function () {",
              "    pm.expect(jsonData.code).to.eql(\"INVALID_CURSOR\");",
              "});"
            ]
          }
        }
