      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tokenA}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectAId}}/videos?cursor=invalid_base64_tampered_cursor",
          "host": ["{{baseUrl}}"],
          "path": ["projects", "{{projectAId}}", "videos"],
          "query": [
            { "key": "cursor", "value": "invalid_base64_tampered_cursor" }
          ]
        }
