        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user.beta.{{$timestamp}}@transvidcloud.io\",\n  \"password\": \"Password123@\",\n  \"fullName\": \"Người Dùng Beta\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        },
        "description": "Đăng ký Người dùng B để kiểm tra tính năng cô lập quyền sở hữu tài nguyên (Multi-tenant Isolation)."
      }
    },
    {
      "name": "11. US5 - Người dùng B cố xem Project của A (403 Forbidden)",
      "event": [
        {
          "listen": "test",
          "script": {
