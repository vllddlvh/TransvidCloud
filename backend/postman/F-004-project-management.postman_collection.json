{
  "info": {
    "_postman_id": "tvc-f004-project-management",
    "name": "F-004: Quản lý Project & Phân quyền sở hữu tài nguyên",
    "description": "Bộ Postman Collection chuyên biệt cho Feature F-004: Quản lý Project & Phân quyền sở hữu tài nguyên (Epic A2). Kiểm thử độc lập toàn bộ vòng đời CRUD, GSI owner-index (sắp xếp mới nhất lên đầu), Soft Delete, kiểm tra an toàn và cô lập quyền sở hữu tài nguyên đa người thuê (Multi-tenant Isolation).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "tokenA",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenB",
      "value": "",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "",
      "type": "string"
    },
    {
      "key": "projectMinimalId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Chuẩn bị - Đăng ký tài khoản Người dùng A",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Trả về accessToken hợp lệ cho User A\", function () {",
              "    pm.expect(jsonData.accessToken).to.be.a('string');",
              "    pm.expect(jsonData.tokenType).to.eql('Bearer');",
              "});",
              "if (jsonData.accessToken) {",
              "    pm.collectionVariables.set('tokenA', jsonData.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user.alpha.{{$timestamp}}@transvidcloud.io\",\n  \"password\": \"Password123@\",\n  \"fullName\": \"Người Dùng Alpha\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        },
        "description": "Đăng ký Người dùng A để tạo phiên làm việc JWT Bearer token."
      }
    },
    {
      "name": "02. US1 - Tạo Project mới đầy đủ thông tin (201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"ProjectId có tiền tố prj_\", function () {",
              "    pm.expect(jsonData.projectId).to.match(/^prj_/);",
              "    pm.expect(jsonData.name).to.eql('Khóa học Spring Boot Cloud Native');",
              "    pm.expect(jsonData.description).to.eql('Kho video bài giảng lập trình Spring Boot');",
              "    pm.expect(jsonData.webhookUrl).to.eql('https://elearning.example.com/api/webhooks');",
              "    pm.expect(jsonData.createdAt).to.be.a('string');",
              "    pm.expect(jsonData.updatedAt).to.be.a('string');",
              "});",
              "if (jsonData.projectId) {",
              "    pm.collectionVariables.set('projectId', jsonData.projectId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Khóa học Spring Boot Cloud Native\",\n  \"description\": \"Kho video bài giảng lập trình Spring Boot\",\n  \"webhookUrl\": \"https://elearning.example.com/api/webhooks\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/projects",
          "host": ["{{baseUrl}}"],
          "path": ["projects"]
        },
        "description": "US1-AC1: Tạo Project mới với đầy đủ tên, mô tả và webhookUrl hợp lệ."
      }
    },
    {
      "name": "03. US1 - Tạo Project chỉ có tên bắt buộc (201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Khởi tạo thành công với mô tả và webhookUrl là null\", function () {",
              "    pm.expect(jsonData.projectId).to.match(/^prj_/);",
              "    pm.expect(jsonData.name).to.eql('Dự án Phụ Không Mô Tả');",
              "    pm.expect(jsonData.description).to.be.null;",
              "    pm.expect(jsonData.webhookUrl).to.be.null;",
              "});",
              "if (jsonData.projectId) {",
              "    pm.collectionVariables.set('projectMinimalId', jsonData.projectId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dự án Phụ Không Mô Tả\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/projects",
          "host": ["{{baseUrl}}"],
          "path": ["projects"]
        },
        "description": "US1-AC2: Tạo Project chỉ có tên bắt buộc, không truyền mô tả và webhookUrl."
      }
    },
    {
      "name": "04. US1 - Tạo Project lỗi dữ liệu - Tên rỗng (400 Bad Request)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Mã lỗi validation chuẩn (code 1001)\", function () {",
              "    pm.expect(jsonData.code).to.eql(1001);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"   \",\n  \"description\": \"Tên không hợp lệ\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/projects",
          "host": ["{{baseUrl}}"],
          "path": ["projects"]
        },
        "description": "US1-AC3: Tên rỗng trả về HTTP 400 Bad Request (VALIDATION_ERROR)."
      }
    },
    {
      "name": "05. US2 - Liệt kê danh sách Project của User A (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Trả về danh sách mảng items có ít nhất 2 project\", function () {",
              "    pm.expect(jsonData.items).to.be.an('array');",
              "    pm.expect(jsonData.items.length).to.be.at.least(2);",
              "});",
              "pm.test(\"Sắp xếp mới nhất lên đầu (createdAt giảm dần)\", function () {",
              "    var minimalId = pm.collectionVariables.get('projectMinimalId');",
              "    pm.expect(jsonData.items[0].projectId).to.eql(minimalId);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/projects",
          "host": ["{{baseUrl}}"],
          "path": ["projects"]
        },
        "description": "US2-AC1: Liệt kê danh sách Project qua GSI owner-index, sắp xếp mới nhất lên đầu (ScanIndexForward = false)."
      }
    },
    {
      "name": "06. US2 - Xem chi tiết Project của User A (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Thông tin Project chính xác\", function () {",
              "    pm.expect(jsonData.projectId).to.eql(pm.collectionVariables.get('projectId'));",
              "    pm.expect(jsonData.name).to.eql('Khóa học Spring Boot Cloud Native');",
              "    pm.expect(jsonData.createdAt).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["projects", "{{projectId}}"]
        },
        "description": "US2-AC3: Xem chi tiết một project đang hoạt động bằng mã projectId."
      }
    },
    {
      "name": "07. US2 - Xem chi tiết Project không tồn tại (404 Not Found)",
