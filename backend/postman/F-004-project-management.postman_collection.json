        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"webhookUrl\": null\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["projects", "{{projectId}}"]
        },
        "description": "US3-AC2: Gỡ bỏ Webhook đã cấu hình bằng cách truyền webhookUrl là null."
      }
    },
    {
      "name": "10. US5 - Chuẩn bị - Đăng ký tài khoản Người dùng B",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
