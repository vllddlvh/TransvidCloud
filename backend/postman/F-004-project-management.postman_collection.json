          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Danh sách rỗng hoặc tuyệt đối không chứa project của A\", function () {",
              "    pm.expect(jsonData.items).to.be.an('array');",
              "    var targetId = pm.collectionVariables.get('projectId');",
              "    var found = jsonData.items.some(function(item) { return item.projectId === targetId; });",
              "    pm.expect(found).to.be.false;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenB}}",
