        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/projects/prj_nonexistent_999",
          "host": ["{{baseUrl}}"],
          "path": ["projects", "prj_nonexistent_999"]
        },
        "description": "US2-AC4: Xem chi tiết project không tồn tại trả về 404 Not Found."
      }
    },
    {
      "name": "08. US3 - Cập nhật thông tin Project (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Tên và mô tả đã được cập nhật thành công\", function () {",
