              "    pm.expect(jsonData.description).to.eql('Mô tả cập nhật mới');",
              "    pm.expect(jsonData.webhookUrl).to.eql('https://elearning.example.com/api/webhooks/v2');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
