        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Khóa học Spring Boot Cloud Native (Updated)\",\n  \"description\": \"Mô tả cập nhật mới\",\n  \"webhookUrl\": \"https://elearning.example.com/api/webhooks/v2\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["projects", "{{projectId}}"]
        },
        "description": "US3-AC1: Cập nhật tên, mô tả và URL webhook của project, làm mới updatedAt."
      }
    },
    {
      "name": "09. US3 - Gỡ bỏ Webhook của Project (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"WebhookUrl đã được gỡ bỏ (chuyển thành null)\", function () {",
              "    pm.expect(jsonData.webhookUrl).to.be.null;",
