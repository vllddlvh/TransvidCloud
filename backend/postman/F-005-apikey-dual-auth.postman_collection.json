        "description": "User B tạo Project Beta để kiểm tra bảo vệ ranh giới Tenant."
      }
    },
    {
      "name": "05. US1 - Tạo API Key 1 thành công (201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"rawKey có tiền tố tvc_live_ và độ dài 41 ký tự\", function () {",
              "    pm.expect(jsonData.rawKey).to.match(/^tvc_live_[0-9a-f]{32}$/);",
              "    pm.expect(jsonData.rawKey.length).to.eql(41);",
              "});",
              "pm.test(\"keyPrefix đúng định dạng rút gọn 8 ký tự hex\", function () {",
              "    pm.expect(jsonData.keyPrefix).to.match(/^tvc_live_[0-9a-f]{8}\\.\\.\\.$/);",
              "    pm.expect(jsonData.rawKey.startsWith(jsonData.keyPrefix.replace('...', ''))).to.be.true;",
              "});",
              "pm.test(\"keyHash là chuỗi SHA-256 64 ký tự hex\", function () {",
              "    pm.expect(jsonData.keyHash).to.match(/^[0-9a-f]{64}$/);",
              "    pm.expect(jsonData.name).to.eql('CI/CD Pipeline Key');",
              "    pm.expect(jsonData.createdAt).to.be.a('string');",
              "});",
              "if (jsonData.rawKey) {",
              "    pm.collectionVariables.set('rawKey1', jsonData.rawKey);",
              "    pm.collectionVariables.set('keyHash1', jsonData.keyHash);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
