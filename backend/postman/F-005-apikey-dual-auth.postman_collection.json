      }
    },
    {
      "name": "08. US2 - Liệt kê API Key của Project A (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Trả về danh sách metadata API Key không lộ rawKey\", function () {",
              "    pm.expect(jsonData.items).to.be.an('array');",
              "    pm.expect(jsonData.items.length).to.be.at.least(1);",
              "    var found = jsonData.items.find(function(k) { return k.keyHash === pm.collectionVariables.get('keyHash1'); });",
              "    pm.expect(found).to.not.be.undefined;",
              "    pm.expect(found.keyPrefix).to.match(/^tvc_live_[0-9a-f]{8}\\.\\.\\.$/);",
              "    pm.expect(found.name).to.eql('CI/CD Pipeline Key');",
              "    pm.expect(found.createdAt).to.be.a('string');",
              "    jsonData.items.forEach(function(item) {",
              "        pm.expect(item.rawKey).to.be.undefined;",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectAId}}/api-keys",
          "host": ["{{baseUrl}}"],
          "path": ["projects", "{{projectAId}}", "api-keys"]
        },
