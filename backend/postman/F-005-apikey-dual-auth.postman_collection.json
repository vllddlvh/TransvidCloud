              "    pm.expect(jsonData.accessToken).to.be.a('string');",
              "    pm.expect(jsonData.tokenType).to.eql('Bearer');",
              "});",
              "if (jsonData.accessToken) {",
              "    pm.collectionVariables.set('tokenB', jsonData.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner.beta.{{$timestamp}}@transvidcloud.io\",\n  \"password\": \"Password123@\",\n  \"fullName\": \"Chủ Sở Hữu Beta\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        },
        "description": "Đăng ký Người dùng B để kiểm tra cô lập đa người thuê (Multi-tenant)."
      }
    },
