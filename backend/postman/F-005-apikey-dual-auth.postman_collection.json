{
  "info": {
    "_postman_id": "tvc-f005-apikey-dual-auth",
    "name": "F-005: Quản lý API Key & Xác thực Dual Security JWT + X-API-Key",
    "description": "Bộ Postman Collection chuyên biệt cho Feature F-005: Quản lý API Key & Xác thực Dual Security JWT + X-API-Key (Epic A2). Kiểm thử độc lập toàn bộ vòng đời sinh khóa CSPRNG, lưu trữ Hash SHA-256 trên DynamoDB, GSI project-index, giới hạn 5 API Keys/Project, xóa cứng tức thì, bộ lọc ApiKeyAuthenticationFilter kiểm soát ranh giới Project và cơ chế ưu tiên Bearer JWT khi gửi đồng thời.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "tokenA",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenB",
      "value": "",
      "type": "string"
    },
    {
      "key": "projectAId",
      "value": "",
      "type": "string"
    },
    {
      "key": "projectBId",
      "value": "",
      "type": "string"
    },
    {
      "key": "rawKey1",
      "value": "",
      "type": "string"
    },
    {
      "key": "keyHash1",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Setup - Đăng ký tài khoản Người dùng A",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Trả về accessToken hợp lệ cho User A\", function () {",
              "    pm.expect(jsonData.accessToken).to.be.a('string');",
              "    pm.expect(jsonData.tokenType).to.eql('Bearer');",
              "});",
              "if (jsonData.accessToken) {",
              "    pm.collectionVariables.set('tokenA', jsonData.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner.alpha.{{$timestamp}}@transvidcloud.io\",\n  \"password\": \"Password123@\",\n  \"fullName\": \"Chủ Sở Hữu Alpha\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        },
        "description": "Đăng ký Người dùng A để tạo phiên làm việc JWT Bearer token."
      }
    },
    {
      "name": "02. Setup - Đăng ký tài khoản Người dùng B",
      "event": [
        {
          "listen": "test",
