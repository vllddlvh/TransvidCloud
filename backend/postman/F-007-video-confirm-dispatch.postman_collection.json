    {
      "name": "01. Setup - Đăng ký tài khoản Người dùng A",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code là 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Trả về accessToken hợp lệ cho User A\", function () {",
              "    pm.expect(jsonData.accessToken).to.be.a('string');",
              "    pm.expect(jsonData.tokenType).to.eql('Bearer');",
              "});",
              "if (jsonData.accessToken) {",
              "    pm.collectionVariables.set('tokenA', jsonData.accessToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user.confirm.a.{{$timestamp}}@transvidcloud.io\",\n  \"password\": \"Password123@\",\n  \"fullName\": \"Chủ Sở Hữu Video A\"\n}"
        },
