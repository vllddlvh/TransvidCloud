    {
      "name": "06. Setup - Người dùng A khởi tạo Video",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code là 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Trả về videoId và presigned uploadUrl\", function () {",
              "    pm.expect(jsonData.video).to.be.an('object');",
              "    pm.expect(jsonData.video.videoId).to.match(/^vid_/);",
              "    pm.expect(jsonData.video.status).to.eql('UPLOADING');",
              "    pm.expect(jsonData.upload).to.be.an('object');",
              "    pm.expect(jsonData.upload.presignedUrl).to.be.a('string');",
              "});",
              "if (jsonData.video && jsonData.video.videoId) {",
              "    pm.collectionVariables.set('videoId', jsonData.video.videoId);",
              "}",
              "if (jsonData.upload && jsonData.upload.presignedUrl) {",
              "    pm.collectionVariables.set('uploadUrl', jsonData.upload.presignedUrl);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Video E2E Test 001\",\n  \"filename\": \"sample.mp4\",\n  \"sizeBytes\": 1024,\n  \"contentType\": \"video/mp4\"\n}"
        },
