    {
      "name": "07. US1 - Khởi tạo Video qua Bearer JWT (201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code là 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Video metadata đúng trạng thái UPLOADING\", function () {",
              "    pm.expect(jsonData.video.status).to.eql('UPLOADING');",
              "    pm.expect(jsonData.video.attemptCount).to.eql(0);",
              "    pm.expect(jsonData.video.videoId).to.match(/^vid_[0-9a-f]{12}$/);",
              "    pm.expect(jsonData.video.projectId).to.eql(pm.collectionVariables.get('projectAId'));",
              "});",
              "pm.test(\"Upload Presigned URL hợp lệ cho source.mp4 và PUT method\", function () {",
              "    pm.expect(jsonData.upload.method).to.eql('PUT');",
              "    pm.expect(jsonData.upload.expiresInSeconds).to.eql(900);",
              "    pm.expect(jsonData.upload.presignedUrl).to.include('source.mp4');",
              "    pm.expect(jsonData.upload.requiredHeaders['Content-Type']).to.eql('video/mp4');",
              "    pm.expect(jsonData.upload.requiredHeaders['Content-Length']).to.eql('12');",
              "});",
              "pm.collectionVariables.set('videoId', jsonData.video.videoId);",
              "pm.collectionVariables.set('presignedUrl', jsonData.upload.presignedUrl);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Bài giảng 1 - Khởi tạo Upload\",\n  \"filename\": \"intro.lecture.MP4\",\n  \"sizeBytes\": 12,\n  \"contentType\": \"video/mp4\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectAId}}/videos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects",
            "{{projectAId}}",
            "videos"
          ]
        },
        "description": "US1: Khởi tạo Video qua Bearer JWT, kiểm tra videoId, trạng thái UPLOADING và nhận S3 Presigned PUT URL."
      }
    },
