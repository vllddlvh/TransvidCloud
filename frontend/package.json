{
  "name": "transvidcloud-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && vite build && node scripts/check-production-bundle.mjs",
    "build:mock": "tsc -b && vite build --mode mock",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript ../docs/contracts/openapi.yaml -o src/api/schema.d.ts",
    "api:check": "openapi-typescript ../docs/contracts/openapi.yaml -o src/api/schema.d.ts --check"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.0",
    "hls.js": "^1.7.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jsdom": "^26.0.0",
    "msw": "^2.12.0",
    "openapi-typescript": "^7.10.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.12",
    "yaml": "^2.8.0"
  },
  "msw": {
    "workerDirectory": [
      "public",
      "../public"
    ]
  }
}
